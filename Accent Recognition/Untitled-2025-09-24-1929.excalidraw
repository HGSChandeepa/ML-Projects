      "link": null,
      "locked": false,
      "text": "Computes the weighted cross-entropy loss between predictions and true labels,\nsimilar to the training phase.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Computes the weighted cross-entropy loss between predictions and true labels, similar to the training phase.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
