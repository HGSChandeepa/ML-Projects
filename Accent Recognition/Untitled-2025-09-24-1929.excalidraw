      ],
      "updated": 1754109714435,
      "link": null,
      "locked": false,
      "text": "Computes the negative log-likelihood loss (cross_entropy) between predictions\nand true labels, weighted to handle class imbalance (weights: [0.577, 3.728] for\nnon-spam and spam).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Computes the negative log-likelihood loss (cross_entropy) between predictions and true labels, weighted to handle class imbalance (weights: [0.577, 3.728] for non-spam and spam).",
      "autoResize": false,
      "lineHeight": 1.25
    },
