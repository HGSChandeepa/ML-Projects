    {
      "id": "1sum6jXllqEhkix0JKNHY",
      "type": "text",
      "x": 13868.719811873872,
      "y": 16278.976230292155,
      "width": 1142.4879770071493,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
