    {
      "id": "57VC_1bvT8fyFm_VFCY0U",
      "type": "text",
      "x": 13864.950533675286,
      "y": 16677.617951327036,
      "width": 1215.5125842706548,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
