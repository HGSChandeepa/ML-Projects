      "link": null,
      "locked": false,
      "text": "Called once per epoch in the run_training() function to evaluate model\nperformance on the validation set (836 samples).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Called once per epoch in the run_training() function to evaluate model performance on the validation set (836 samples).",
