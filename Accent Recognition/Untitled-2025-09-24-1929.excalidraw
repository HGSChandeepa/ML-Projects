      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "TV1HpIX2AZ4UyFB1qGTKX",
        "hvKSWD45A6-VhB9gx2ARX",
        "7AbNSvuwSHCRzG-bRdeIq",
        "hbAu7_xFaUE3wQnYuatSu"
      ],
      "frameId": null,
      "index": "bHC",
      "roundness": null,
      "seed": 632453993,
      "version": 67,
      "versionNonce": 1917462734,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1758722362417,
      "link": null,
      "locked": false,
      "text": "Step 10: Calculate Loss\n\nCompare Main Network prediction with the target:\n\nThis measures how far off the predictions are.",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 10: Calculate Loss\n\nCompare Main Network prediction with the target:\n\nThis measures how far off the predictions are.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Q1VQPL-8s97qJmk3xeQQZ",
      "type": "text",
      "x": 104.08880672408759,
      "y": 6237.825078136766,
      "width": 950.1837158203125,
      "height": 225,
