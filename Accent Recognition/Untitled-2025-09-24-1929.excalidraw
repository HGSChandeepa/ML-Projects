    {
      "id": "Wz2rB9j0LOIvYwc733Veh",
      "type": "text",
      "x": 13869.577424906769,
      "y": 15763.598542394495,
      "width": 1013.8566633288083,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
