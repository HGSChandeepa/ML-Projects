    },
    {
      "id": "a3N_FK7AIySNyoyhAG-Et",
      "type": "text",
      "x": 5985.528789052061,
      "y": 3503.9083101951574,
      "width": 203.63182067871094,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b08",
      "roundness": null,
      "seed": 1085864978,
      "version": 9,
      "versionNonce": 1336174987,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753107053188,
      "link": null,
      "locked": false,
      "text": "y^2 = x^3 +2x +3 (mod 5)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "right",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "y^2 = x^3 +2x +3 (mod 5)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FMhY3Ai43ma-s7A8tbuAX",
      "type": "text",
      "x": 5895.43286467462,
      "y": 3563.9083101951574,
      "width": 383.82366943359375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b09",
      "roundness": null,
      "seed": 7472654,
      "version": 9,
      "versionNonce": 2048196651,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753107053188,
      "link": null,
      "locked": false,
      "text": "p3 = p1 + p2 = (1,4) + (3,1) = (x1 , y1) + (x2 , y2)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "right",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "p3 = p1 + p2 = (1,4) + (3,1) = (x1 , y1) + (x2 , y2)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KqsjYcI_rxQKwwSC9Ow2u",
      "type": "text",
      "x": 5903.752871998839,
      "y": 3623.9083101951574,
      "width": 367.18365478515625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0A",
      "roundness": null,
      "seed": 2082712018,
      "version": 9,
      "versionNonce": 1132053195,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753107053188,
      "link": null,
      "locked": false,
      "text": "if p1 not equal  m =  (y2 -y1)(x2 - x1)^-1 mod p",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "right",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if p1 not equal  m =  (y2 -y1)(x2 - x1)^-1 mod p",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GhYAu2EAYJuAK9DI4AgDW",
      "type": "text",
      "x": 5972.560817250303,
      "y": 3683.9083101951574,
      "width": 229.56776428222656,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0B",
      "roundness": null,
      "seed": 144839758,
      "version": 9,
      "versionNonce": 342700395,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753107053188,
      "link": null,
      "locked": false,
      "text": "m  = (1-4) (3-1) inverse mod 5",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "right",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "m  = (1-4) (3-1) inverse mod 5",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "b0CMwfbv9BvcWjfYLg7Qm",
      "type": "text",
      "x": 6015.360774525694,
      "y": 3713.9083101951574,
      "width": 143.9678497314453,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 1500684178,
      "version": 9,
      "versionNonce": 1580846091,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753107053188,
      "link": null,
      "locked": false,
      "text": "= -3 * 2 ^-1 mod 5",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "right",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "= -3 * 2 ^-1 mod 5",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wNlyHJcx8u3-AsjXwMyHm",
      "type": "text",
      "x": 5138.169528492979,
      "y": 3743.9083101951574,
      "width": 1201.054931640625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 607541902,
      "version": 151,
      "versionNonce": 81400491,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753107053188,
      "link": null,
      "locked": false,
      "text": "= -3mod 5 (additive inverse here we need to chack for 3 mode 5 to be 1) * 2^-1 mod 5 (multiplicative inverse here we need ti check for 2 mod  5 to be 0)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "right",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "= -3mod 5 (additive inverse here we need to chack for 3 mode 5 to be 1) * 2^-1 mod 5 (multiplicative inverse here we need ti check for 2 mod  5 to be 0)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "paYjZm2oZdEl-5tQF1xnC",
      "type": "text",
      "x": 5959.96882964044,
      "y": 3773.9083101951574,
      "width": 254.75173950195312,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0E",
      "roundness": null,
      "seed": 618454354,
      "version": 9,
      "versionNonce": 150504779,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1753107053188,
      "link": null,
      "locked": false,
      "text": "= 2     * 3 mod 5 =  6 mod 5 = 1",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "right",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "= 2     * 3 mod 5 =  6 mod 5 = 1",
      "autoResize": true,
      "lineHeight": 1.25
    },
