      "isDeleted": false,
      "boundElements": [],
      "updated": 1758722362417,
      "link": null,
      "locked": false,
      "text": "Step 9: Predict Target Q-values (Next State)\n\nUse the Target Network to compute:\n\nThe max Q-value for the next state.",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 9: Predict Target Q-values (Next State)\n\nUse the Target Network to compute:\n\nThe max Q-value for the next state.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5N00JNiT0GsH8bjYtCiDZ",
      "type": "text",
      "x": 127.42224178268134,
      "y": 5653.158228364631,
      "width": 817.4155883789062,
      "height": 225,
