      "updated": 1753107053188,
      "link": null,
      "locked": false,
      "text": "(1,4) (3,1)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "right",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(1,4) (3,1)",
