      "isDeleted": false,
      "boundElements": [],
      "updated": 1754109714435,
      "link": null,
      "locked": false,
      "text": "Purpose\n\nEvaluates the model on the validation dataset to compute the validation loss\nand predictions without updating model parameters.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Purpose\n\nEvaluates the model on the validation dataset to compute the validation loss and predictions without updating model parameters.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "vVJd7DwNxB4SwQBD7qFNl",
      "type": "text",
      "x": 14728.854653326018,
