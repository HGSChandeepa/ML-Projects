    {
      "id": "ZjWPaJVtg8KpBgbQu5v1L",
      "type": "text",
      "x": 14499.400937801469,
      "y": 19907.969637392867,
      "width": 758.1795654296875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Lv35P9mhkDM9xS5H_IYSI",
        "5CZbdNRyhlHPkTZYsbxs-"
      ],
      "frameId": null,
      "index": "b8bz",
      "roundness": null,
      "seed": 1636542071,
      "version": 198,
      "versionNonce": 1719477475,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755226285060,
      "link": null,
      "locked": false,
      "text": "Called once per epoch in the run_training() function to train the model on the\nentire training dataset (3900 samples).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Called once per epoch in the run_training() function to train the model on the entire training dataset (3900 samples).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "CNheB4Vu3dYUYb-8uxm_i",
      "type": "text",
      "x": 14486.881009822953,
      "y": 19967.969637392867,
      "width": 783.2194213867188,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Lv35P9mhkDM9xS5H_IYSI",
        "5CZbdNRyhlHPkTZYsbxs-"
      ],
      "frameId": null,
      "index": "b8c",
      "roundness": null,
      "seed": 188833913,
      "version": 257,
      "versionNonce": 654200525,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755226285060,
      "link": null,
      "locked": false,
      "text": "Updates the weights of the custom classification layers (fc1, fc2) while keeping\nBERT’s parameters frozen. (we frozened all the initail layers in the BERT)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Updates the weights of the custom classification layers (fc1, fc2) while keeping BERT’s parameters frozen. (we frozened all the initail layers in the BERT)",
      "autoResize": false,
      "lineHeight": 1.25
    },
