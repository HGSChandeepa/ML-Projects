        }
      ],
      "updated": 1754109714435,
      "link": null,
      "locked": false,
      "text": "Sets the model to evaluation mode using model.eval(), disabling layers like dropout\nfor consistent predictions.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sets the model to evaluation mode using model.eval(), disabling layers like dropout for consistent predictions.",
      "autoResize": false,
      "lineHeight": 1.25
    },
