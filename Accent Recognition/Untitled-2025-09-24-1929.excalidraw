      "link": null,
      "locked": false,
      "text": "comes from the Target Network, not the Main\none.",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "comes from the Target Network, not the Main one.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "MaT3e5teqNMVkm-_5SeZ8",
      "type": "text",
      "x": 535.1412010460731,
      "y": 3313.045369274466,
      "width": 749.69970703125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
