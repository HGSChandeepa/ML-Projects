    {
      "id": "6nlM7oZWbmIpx--oE68K_",
      "type": "text",
      "x": 14738.109366528042,
      "y": 20914.003763528166,
      "width": 758.359375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "5CZbdNRyhlHPkTZYsbxs-"
      ],
      "frameId": null,
      "index": "b8bG",
      "roundness": null,
      "seed": 1787026519,
      "version": 170,
      "versionNonce": 601733081,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "QZiDwvzjd67LJz4bEffgL",
          "type": "arrow"
        }
      ],
      "updated": 1754109714435,
      "link": null,
      "locked": false,
      "text": "Uses torch.no_grad() to disable gradient tracking, reducing memory usage and\nspeeding up evaluation.\n\nPrevents PyTorch from building a computational graph for operations,\nreducing memory usage and speeding up computations when gradients are not\nneeded (e.g., during inference or evaluation).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Uses torch.no_grad() to disable gradient tracking, reducing memory usage and speeding up evaluation.\n\nPrevents PyTorch from building a computational graph for operations, reducing memory usage and speeding up computations when gradients are not needed (e.g., during inference or evaluation).",
      "autoResize": false,
      "lineHeight": 1.25
    },
