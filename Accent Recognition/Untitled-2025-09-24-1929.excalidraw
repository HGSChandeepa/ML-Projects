      "boundElements": [],
      "updated": 1758722362417,
      "link": null,
      "locked": false,
      "text": "Usage 3: Prevents the training process from\nchasing a moving target.",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Usage 3: Prevents the training process from chasing a moving target.",
      "autoResize": false,
      "lineHeight": 1.25
    },
