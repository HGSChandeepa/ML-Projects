    {
      "id": "wE8CGkygq2vmu3DsPBIFJ",
      "type": "text",
      "x": 13427.011576366382,
      "y": 5988.21270887628,
      "width": 566.3813549225488,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9i",
      "roundness": null,
      "seed": 1130459811,
      "version": 38,
      "versionNonce": 1508090477,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755239594628,
      "link": null,
      "locked": false,
      "text": "Google Cloud Storage (GCS): For data and artifact storage.\n\nCompute Engine: For a highly configurable, GPU-enabled environment to\nrun your training jobs and serving containers.\n\nCloud Build: For automating the CI/CD pipeline, including container image\ncreation and workflow orchestration.\n\nCloud Run or Compute Engine with a Load Balancer: For deploying your\nmodel as a scalable and accessible API.\n\nCloud Functions/Cloud Scheduler: For triggering pipeline steps based on\nevents or a schedule.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Google Cloud Storage (GCS): For data and artifact storage.\n\nCompute Engine: For a highly configurable, GPU-enabled environment to run your training jobs and serving containers.\n\nCloud Build: For automating the CI/CD pipeline, including container image creation and workflow orchestration.\n\nCloud Run or Compute Engine with a Load Balancer: For deploying your model as a scalable and accessible API.\n\nCloud Functions/Cloud Scheduler: For triggering pipeline steps based on events or a schedule.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "PpO2lHouyoe3y5J9aCp0h",
      "type": "text",
      "x": 13431.05892990948,
      "y": 6319.937264909367,
      "width": 319.2489929199219,
      "height": 120.81041392037324,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9j",
      "roundness": null,
      "seed": 2030414637,
      "version": 145,
      "versionNonce": 2135245155,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755239670074,
      "link": null,
      "locked": false,
      "text": "GCS for all the data and the models\n\ngs://your-bucket/yolo-project/data/raw/\n\ngs://your-bucket/yolo-project/data/processed/\n\ngs://your-bucket/yolo-project/models/",
      "fontSize": 13.806904448042657,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GCS for all the data and the models\n\ngs://your-bucket/yolo-project/data/raw/\n\ngs://your-bucket/yolo-project/data/processed/\n\ngs://your-bucket/yolo-project/models/",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "o0lt-ue60Jt7dwvURYjnB",
      "type": "text",
      "x": 13372.082162045446,
      "y": 6481.205932411197,
      "width": 585.6612563822792,
      "height": 252.6679311859225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9k",
      "roundness": null,
      "seed": 1575352387,
      "version": 667,
      "versionNonce": 1284878733,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755240458728,
      "link": null,
      "locked": false,
      "text": "Cloud Build - for the multistep CI/CD pipelines here we are using a cloudbild.yaml\nfile\n\n- Step 1\n Create Dockerfile.train\n\n- Step 2\n define the cloudbuild.yaml\n\nHere inthis file we need to define ,\n\n    1.Build the trainig container from the dockerfile and get the traing image\n    2.Push the training container to Artifact Registry\n    3.Run the training job on a Compute Engine instance ",
      "fontSize": 14.43816749633843,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cloud Build - for the multistep CI/CD pipelines here we are using a cloudbild.yaml file\n\n- Step 1\n Create Dockerfile.train\n\n- Step 2\n define the cloudbuild.yaml\n\nHere inthis file we need to define ,\n\n    1.Build the trainig container from the dockerfile and get the traing image\n    2.Push the training container to Artifact Registry\n    3.Run the training job on a Compute Engine instance ",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "h1Cd2UHH2o23M-sfXqWJE",
      "type": "text",
      "x": 13382.168714151076,
      "y": 6771.821241337767,
      "width": 668.38330078125,
      "height": 560,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAB",
      "roundness": null,
      "seed": 395925315,
      "version": 51,
      "versionNonce": 610230157,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755240195176,
      "link": null,
      "locked": false,
      "text": "steps:\n# Step 1: Build the training container image\n- name: 'gcr.io/cloud-builders/docker'\n  args: ['build', '-t', 'gcr.io/$PROJECT_ID/yolo-trainer:latest', '-f', 'Dockerfile.train', '.']\n\n# Step 2: Push the training container to Artifact Registry\n- name: 'gcr.io/cloud-builders/docker'\n  args: ['push', 'gcr.io/$PROJECT_ID/yolo-trainer:latest']\n\n# Step 3: Run the training job on a Compute Engine instance\n- name: 'gcr.io/cloud-builders/gcloud'\n  args:\n  - 'compute'\n  - 'instances'\n  - 'create'\n  - 'yolo-trainer'\n  - '--project=$PROJECT_ID'\n  - '--zone=your-preferred-zone'\n  - '--machine-type=n1-standard-4' # Or a custom machine type\n  - '--boot-disk-size=100GB'\n  - '--image-family=debian-11'\n  - '--image-project=debian-cloud'\n  - '--metadata-from-file=startup-script=startup_script.sh'\n  - '--accelerator=type=nvidia-tesla-t4,count=1'\n  - '--maintenance-policy=TERMINATE'\n  - '--scopes=default,https://www.googleapis.com/auth/devstorage.read_write'\n  - '--labels=purpose=yolo-training'\n  timeout: 10800s # 3 hours",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "steps:\n# Step 1: Build the training container image\n- name: 'gcr.io/cloud-builders/docker'\n  args: ['build', '-t', 'gcr.io/$PROJECT_ID/yolo-trainer:latest', '-f', 'Dockerfile.train', '.']\n\n# Step 2: Push the training container to Artifact Registry\n- name: 'gcr.io/cloud-builders/docker'\n  args: ['push', 'gcr.io/$PROJECT_ID/yolo-trainer:latest']\n\n# Step 3: Run the training job on a Compute Engine instance\n- name: 'gcr.io/cloud-builders/gcloud'\n  args:\n  - 'compute'\n  - 'instances'\n  - 'create'\n  - 'yolo-trainer'\n  - '--project=$PROJECT_ID'\n  - '--zone=your-preferred-zone'\n  - '--machine-type=n1-standard-4' # Or a custom machine type\n  - '--boot-disk-size=100GB'\n  - '--image-family=debian-11'\n  - '--image-project=debian-cloud'\n  - '--metadata-from-file=startup-script=startup_script.sh'\n  - '--accelerator=type=nvidia-tesla-t4,count=1'\n  - '--maintenance-policy=TERMINATE'\n  - '--scopes=default,https://www.googleapis.com/auth/devstorage.read_write'\n  - '--labels=purpose=yolo-training'\n  timeout: 10800s # 3 hours",
      "autoResize": true,
      "lineHeight": 1.25
    },
