      "updated": 1754109714435,
      "link": null,
      "locked": false,
      "text": "Resets gradients (model.zero_grad()), computes gradients via loss.backward(),\nand clips gradients to 1.0 (torch.nn.utils.clip_grad_norm_) to prevent exploding\ngradients.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Resets gradients (model.zero_grad()), computes gradients via loss.backward(), and clips gradients to 1.0 (torch.nn.utils.clip_grad_norm_) to prevent exploding gradients.",
      "autoResize": false,
      "lineHeight": 1.25
    },
