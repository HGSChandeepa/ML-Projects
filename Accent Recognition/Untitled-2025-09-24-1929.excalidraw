      "frameId": null,
      "index": "bHZ",
      "roundness": null,
      "seed": 1353417225,
      "version": 181,
      "versionNonce": 1717804750,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1758722362417,
      "link": null,
      "locked": false,
      "text": "Usage 2: Updates only periodically (e.g., every\n1000 steps → copy weights from Main).",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Usage 2: Updates only periodically (e.g., every 1000 steps → copy weights from Main).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
