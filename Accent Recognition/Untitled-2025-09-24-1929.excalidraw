      "type": "text",
      "x": 5926.856814869932,
      "y": 3833.9083101951574,
      "width": 320.97576904296875,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
